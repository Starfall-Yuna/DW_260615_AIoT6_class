package Controller;

import java.util.Scanner;
import Service.ItemService;

public class Main {
	public static void main(String[] args) {
		Scanner scan = new Scanner(System.in);
		
		while(true) {
			System.out.println("< 원하는 기능을 입력해주세요 >");
			System.out.println("1. 데이터 전체 조회");
			System.out.println("0. 실행 종료");
			
			int number = scan.nextInt();
			
			switch(number) {
			case 1:
				ItemService.selectItem();
				break;
			case 0:
				System.out.println("실행을 종료합니다.");
				System.exit(0);
			default:
				System.out.println("다시 입력해주시길 바랍니다.");
			}
		}
	}

}
