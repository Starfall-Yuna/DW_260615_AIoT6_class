package Model;

// DB Item 테이블 칼럼과 동일한 구성의
// Model.Item 클래스
public class Item {
	// item_id varchar(20) primary key,
    // name varchar(100),
    // price int
	String item_id;
	String name;
	int price;
	
	// DB 데이터를 매개변수로 받고,
	// 3개의 멤버값을 초기화
	public Item(String i, String n, int p) {
		this.item_id = i;
		this.name = n;
		this.price = p;
	}
}
