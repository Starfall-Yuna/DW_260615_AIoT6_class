package MainFunc;

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.util.Scanner;

// MainFunc.Function.java :: Service(서비스)

// 실제 기능들을 구현할 예정 (DB접속, 테이블 데이터 조작, ...)
public class Function {
	static String url = "jdbc:mysql://localhost:3306/test_db";
	static String username = "root";
	static String passwd = "1234";
	
	// selectSQL() :: 데이터 조회 기능
	public static void selectSQL() {
		//  전체 데이터, [상품명, 가격] 칼럼 조회
		String sql = "SELECT name, price FROM ITEM;";
		
		//	DB 접속 + SELECT문 실행 구문
		try {
			Connection cn = DriverManager.getConnection(url, username, passwd);
			System.out.println("--- DB접속 성공 ---");
			
			PreparedStatement ps = cn.prepareStatement(sql);
			ResultSet rs = ps.executeQuery();	// SELECT 결과 저장
			
			while(rs.next()) {
				String item_name = rs.getString("name");
				String item_price = rs.getString("price")
			}
		}catch(Exception e) {
			System.out.println("[데이터 조회] 작업 실패");
			e.printStackTrace();
		}
		
	}
	// insertSQL() :: 데이터 삽입 기능
	public static void insertSQL() {
		// 1. 삽입할 데이터 정보 사용자에게 입력받기
		Scanner scan = new Scanner(System.in);
		System.out.print("추가할 상품의 id를 입력하세요. ");
		String input_id = scan.next();
		System.out.print("추가할 상품의 이름을 입력하세요. ");
		String input_name = scan.next();
		System.out.print("추가할 상품의 가격을 입력하세요. ");
		int input_price = scan.nextInt();
		
		String sql = "insert into item values (?, ?, ?);";
		
		try {
			// 1. DB 접속 
			Connection con = DriverManager.getConnection(url, username, passwd);
			System.out.println("--- DB접속 성공 ---");
			
			PreparedStatement ps = con.prepareStatement(sql);
			ps.setString(1, input_id);
			ps.setString(2, input_name);
			ps.setInt(3, input_price);
			
			ps.executeUpdate();
			System.out.println("[데이터 삽입] 작업 성공");
		}catch(Exception e) {
			System.out.println("[데이터 삽입] 작업 실패");
			e.printStackTrace();
		}
	}
	
	public static void updateSQL() {
		Scanner scan = new Scanner(System.in);
		
		//	1. 상품ID를 입력받고, 해당 상품의 가격을 수정할 값을 입력받기
		System.out.print("가격을 수정할 상품ID를 입력하세요. ");
		String target_id = scan.next();
		System.out.print("수정할 가격을 입력하세요. ");
		int target_price = scan.nextInt();
		
		//	2. DB 접속하고, 위 2개 입력 기반으로 update 실행
		String sql = "update item set price = ? where item_id = ?;";
		try {
			Connection con = DriverManager.getConnection(url, username, passwd);
			System.out.println("--- DB접속 완료 ---");
			
			PreparedStatement ps = con.prepareStatement(sql);
			ps.setInt(1, target_price);
			ps.setString(2, target_id);
			
			ps.executeUpdate();
			System.out.println("[데이터 수정] 작업 완료");
		}catch(Exception e) {
			System.out.println("[데이터 수정] 작업 실패");
			e.printStackTrace();	// 오류가 발생한 순서 나열
		}
	}
	public static void deleteSQL() {
		Scanner scan = new Scanner(System.in);
		
		// 	1. 상품ID를 입력받기
		System.out.print("삭제할 상품의 ID를 입력하세요. ");
		String target_id = scan.next();
		
		//	2. DB 접속하고, 위 1개 입력 기반으로 delete 실행
		String sql = "delete from item where item_id = ?;";
		
		try {
			Connection con = DriverManager.getConnection(url, username, passwd);
			System.out.println("--- DB접속 성공 ---");
			
			PreparedStatement ps = con.prepareStatement(sql);
			ps.setString(1, target_id);
			
			ps.executeUpdate();
			System.out.println("[데이터 삭제] 작업 성공");
		}catch(Exception e) {
			System.out.println("[데이터 삭제] 작업 실패");
			e.printStackTrace();
		}
	}
}




