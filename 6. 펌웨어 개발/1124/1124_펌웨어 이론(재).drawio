<mxfile host="Electron">
  <diagram name="페이지-1" id="e4F_6Ri28wD_2j7aiK5_">
    <mxGraphModel dx="1018" dy="477" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="* 컴퓨터의 기본 구성 요소" vertex="1">
          <mxGeometry height="30" width="250" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="- CPU(중앙처리장치)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 실제로 연산/판단하는 장치&lt;div&gt;- RAM(주기억장치)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: &quot;실행 중&quot; 프로그램/데이터 임시 저장&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&quot;얼마나 많은 프로그램을 띄울 수 있는가&quot;에 대한 성능 결정&lt;br&gt;&lt;/div&gt;&lt;div&gt;- SSD(보조기억장치)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 프로그램/데이터 장기간 저장&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;로컬디스크 C, 로컬디스크 D가 해당됨&lt;br&gt;&lt;/div&gt;&lt;div&gt;- 입출력 장치&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: (입력) 키보드, 마우스, 마이크, ... / (출력) 모니터, 스피커, ...&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="480" x="70" y="80" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="- HW(하드웨어)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 컴퓨터 밖으로의 물리적인 장치&lt;div&gt;- SW(소프트웨어)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;::&amp;nbsp; HW가 수행할 작업을 명령하는 프로그램&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="350" x="40" y="190" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="- Thonny에서 작성 중인 마이크로파이썬 프로그램들이, SW(소프트웨어)에 해당&lt;div&gt;- ESP32-S3 기반으로 작동하는 드론 키트를, HW(하드웨어)에 해당&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="420" x="70" y="230" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="* 임베디드 시스템" vertex="1">
          <mxGeometry height="30" width="250" x="40" y="280" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-6" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="* 펌웨어 :: HW가 작업을 수행하도록 제어하는 &lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;&quot;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;S&lt;/font&gt;&lt;/font&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;W&quot;&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="430" x="40" y="370" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-7" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="- HW와 SW가 결합된 상태&lt;div&gt;- HW에,&amp;nbsp; 특정 기능을 수행할 수 있도록 SW가 포함된 컴퓨터 시스템&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp;(작업에 대한 특정 목적이 정해짐)&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="420" x="70" y="310" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-9" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&amp;lt;드론키트 usb포트 연결&amp;gt;&lt;div&gt;1) 전원 공급&lt;/div&gt;&lt;div&gt;2) 보드(ESP32-S3) 부팅 및 초기화&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;lt;펌웨어(SW) 실행&amp;gt;&lt;/div&gt;&lt;div&gt;3) 센서 및 외부 장치 연결 상태 확인&lt;/div&gt;&lt;div&gt;4) 프로그램 코드 실행&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="120" width="420" x="70" y="400" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-10" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="* 아날로그 신호, 디지털 신호" vertex="1">
          <mxGeometry height="30" width="250" x="600" y="40" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="- 아날로그 신호 :: 연속적으로(끊김없이) 변화하는 물리적 값 표현 신호&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(ex) 빛의 밝기, 온도, 습도, ... 등&lt;br&gt;&lt;div&gt;- 디지털 신호 :: 2가지의 상태만으로 정보 표현 신호&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- HIGH (1, 켜짐 등을 의미하는 상태)&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- LOW (0, 꺼짐 등을 의미하는 상태)&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="90" width="400" x="640" y="80" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-12" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="144.97" width="275" x="674" y="173" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-13" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="0" vertex="1">
          <mxGeometry height="30" width="60" x="837" y="293" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1" vertex="1">
          <mxGeometry height="30" width="60" x="793" y="260" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="1" vertex="1">
          <mxGeometry height="30" width="60" x="828" y="183" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-16" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="0" vertex="1">
          <mxGeometry height="30" width="60" x="759" y="223" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-17" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="* 디지털 데이터 단위" vertex="1">
          <mxGeometry height="30" width="180" x="600" y="340" as="geometry" />
        </mxCell>
        <mxCell id="IcNsYLFoNPrXCsRi0vwc-18" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="&lt;div&gt;- 비트(bit)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 정보를 표현하는 가장 기본적인 단위&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(1bit에, &lt;font style=&quot;color: rgb(0, 0, 255);&quot;&gt;0(LOW) 또는 1(HIGH)의 값을 가짐&lt;/font&gt;)&lt;br&gt;&lt;/div&gt;&lt;div&gt;- 바이트(byte)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;::&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;8bit = 1byte&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; (1byte 표현 예시) 1001 1011, 1111 1111, 1101 1000, ...&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="400" x="640" y="380" as="geometry" />
        </mxCell>
      </root>
