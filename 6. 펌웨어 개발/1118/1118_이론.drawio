        <mxCell id="rY5RbwOTpK94hLQRn5Hv-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=default;fillColor=default;align=left;verticalAlign=top;rounded=0;" value="&lt;div style=&quot;background-color: rgb(255, 255, 254); font-family: Consolas, &amp;quot;Courier New&amp;quot;, monospace; font-size: 14px; line-height: 19px; white-space: pre;&quot;&gt;&lt;div&gt;green_led = Pin(&lt;span style=&quot;color: rgb(9, 134, 88);&quot;&gt;42&lt;/span&gt;,Pin.OUT)&lt;/div&gt;&lt;div&gt;key = Pin(&lt;span style=&quot;color: rgb(9, 134, 88);&quot;&gt;0&lt;/span&gt;, Pin.IN, Pin.PULL_UP)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="55" width="400" x="50" y="795" as="geometry" />
