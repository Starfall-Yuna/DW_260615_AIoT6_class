        <mxCell id="rY5RbwOTpK94hLQRn5Hv-22" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontColor=#CC6600;fontStyle=1" value="2. ESP32(GND)&lt;div&gt;전류 돌아감&lt;/div&gt;" vertex="1">
