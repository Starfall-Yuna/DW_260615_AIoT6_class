        </mxCell>
        <mxCell id="xbb5nEO51YH3j4kvfIJr-2" parent="1" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=18;" value="펌웨어는 데이터를 숫자로 처리" vertex="1">
          <mxGeometry height="40" width="270" x="850" y="145" as="geometry" />
        </mxCell>
        <mxCell id="xbb5nEO51YH3j4kvfIJr-3" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;" value="- 2진수(&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;0b&lt;/font&gt;)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 2개의 기호(0, 1)로 표현&lt;div&gt;- 10진수&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 10개의 기호(0~9)로 표현&lt;/div&gt;&lt;div&gt;- 16진수(&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;0x&lt;/font&gt;)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 16개의 기호(0~9, A~F)로 표현&lt;/div&gt;&lt;div&gt;- ASCII&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 아스키코드표 근거하여, 문자-숫자 변환&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="350" x="880" y="190" as="geometry" />
        </mxCell>
        <mxCell id="xbb5nEO51YH3j4kvfIJr-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=10;" value="&lt;div&gt;print(bin(25))&amp;nbsp; &amp;nbsp; &amp;nbsp;# 2진수&amp;nbsp; (0, 1 표현)&lt;/div&gt;&lt;div&gt;print(25)&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; # 10진수 (0~9 표현)&lt;/div&gt;&lt;div&gt;print(hex(28))&amp;nbsp; &amp;nbsp; &amp;nbsp;# 16진수 (0~9, A(10)~F(15) 표현)&lt;/div&gt;&lt;div&gt;print(ord(&#39;a&#39;))&amp;nbsp; &amp;nbsp; # ASCII&amp;nbsp; (문자 &amp;lt;-&amp;gt; 숫자)&lt;/div&gt;&lt;div&gt;print()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;num = 0b11001&lt;/div&gt;&lt;div&gt;print(int(num))&lt;/div&gt;&lt;div&gt;print(hex(num))&lt;/div&gt;&lt;div&gt;print()&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;num = 0x2b&lt;/div&gt;&lt;div&gt;print(bin(num))&lt;/div&gt;&lt;div&gt;print(int(num))&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="180" width="246" x="1274" y="135" as="geometry" />
        </mxCell>
