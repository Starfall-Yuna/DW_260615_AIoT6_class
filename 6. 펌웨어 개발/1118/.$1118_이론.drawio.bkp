        <mxCell id="rY5RbwOTpK94hLQRn5Hv-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="* 펌웨어 :: HW가 정해진 기능 수행하도록 제어하는 &lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;SW&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="460" x="40" y="150" as="geometry" />
        </mxCell>
        <mxCell id="rY5RbwOTpK94hLQRn5Hv-2" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontSize=18;" value="* 컴퓨터의 기본 구성 요소" vertex="1">
          <mxGeometry height="30" width="250" x="40" y="40" as="geometry" />
        </mxCell>
        <mxCell id="rY5RbwOTpK94hLQRn5Hv-3" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;horizontal=1;" value="- CPU(중앙처리장치)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 실제로 계산/판단하는 장치&lt;br&gt;- RAM(주기억장치)&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;:: &quot;실행 중&quot; 프로그램/데이터 임시 저장&lt;br&gt;- SSD(보조기억장치)&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: 프로그램/데이터 장기간 저장&lt;br&gt;- 입출력 장치&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;:: (입력) 마우스, 키보드, ... / (출력) 모니터, 스피커, ..." vertex="1">
          <mxGeometry height="70" width="420" x="60" y="70" as="geometry" />
        </mxCell>
        <mxCell id="rY5RbwOTpK94hLQRn5Hv-4" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;horizontal=1;" value="(&quot;컴퓨터 구조&quot; 상세 참고)" vertex="1">
          <mxGeometry height="30" width="150" x="280" y="40" as="geometry" />
        </mxCell>
        <mxCell id="rY5RbwOTpK94hLQRn5Hv-5" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;horizontal=1;" value="- 여기서 HW(하드웨어)는 ESP32-S3 기반의 드론 키트&lt;div&gt;- 여기서 SW(소프트웨어)는 Thonny에서 작성 중인 마이크로파이썬 프로그램들&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="420" x="60" y="190" as="geometry" />
        </mxCell>
        <mxCell id="rY5RbwOTpK94hLQRn5Hv-6" edge="1" parent="1" style="endArrow=none;html=1;rounded=0;fontSize=12;" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="40" y="240" as="sourcePoint" />
            <mxPoint x="560" y="240" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="rY5RbwOTpK94hLQRn5Hv-7" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="280" width="519.55" x="40" y="260" as="geometry" />
        </mxCell>
        <mxCell id="rY5RbwOTpK94hLQRn5Hv-8" parent="1" style="text;html=1;align=left;verticalAlign=top;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=12;horizontal=1;" value="- GPIO (General Purpose Input/Output) ::&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;(&quot;GPIO 42번 핀에 초록등을 연결해서 출력 모드로 설정&quot;,&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;&quot;GPIO 0번 핀에 KEY 버튼을 연결해서 입력 모드로 설정&quot;)&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;외부 장치(입력, 출력, 센서, ...)랑 정보를 주고받기 위한 핀&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- GND(Ground) ::&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;밖으로 보낸 전기가 다시 돌아오는 핀&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- 3V3, 5V0 ::&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;전원을 위한 전기를 각각 3.3V, 5V 공급하는 핀 (차후 설명 예정)&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="160" width="360" x="60" y="570" as="geometry" />
        </mxCell>
