
// 상속 :: "부모가 자식에게 상속"		-> 부모 클래스, 자식 클래스 (클래스 간의 관계)
class Phone{
	// - 필드 :: 기종, 전화번호
	public String name;
	public String number;
}
class SmartPhone extends Phone{		// "SmartPhone 클래스 생성, Phone의 멤버를 상속"
	// - 필드 :: 기종, 전화번호, 운영체제, 인터넷 속도
	public String os;
	public String internet;
}

public class extend {
	public static void main(String args[]) {
		Phone p = new Phone();
		SmartPhone sp = new SmartPhone();
		
		p.name = "롤리팝";
		p.number = "000-0000-0000";
//		p.os = null;
//		p.internet = "2G";
		
		sp.name = "Galaxy S23";
		sp.number = "000-1234-5678";
		sp.os = "Android";
		sp.internet = "5G";
	}
}
