
class ToDo{
	// 클래스 구성 요소 :: 필드, 메소드, "생성자"
	// 	- 생성자 :: 인스턴스를 생성하는 특수한 메소드(함수)
	
	// 필드 :: content(할일 내용), date(마감일)
	public String content;
	public String date;
	
	// 메소드 :: printToDo()
	public void printToDo() {
		System.out.println("해야할 일: "+this.content);
		System.out.println("마감일: "+this.date);
	}
}

public class Constructor {
	public static void main(String[] args) {
		// 인스턴스 t1 생성
		ToDo t1 = new ToDo();

	}

}
