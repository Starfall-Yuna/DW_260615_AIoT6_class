
// * Watch 클래스 생성
class Watch{
	// - 필드 :: hour(시), min(분), sec(초)
	public int hour;
	public int min;
	public int sec;
	// - 메소드 :: Time()
	public void Time() {
		// "현재는 오전/오후 00시 00분 00초입니다." 정보 출력
		if(0<=this.hour && this.hour<12) {	// 오전인 경우
			System.out.println("현재는 오전 "+this.hour+"시 "+this.min+"분 "+this.sec+"초입니다.");
		}
		else if(this.hour == 12){
			System.out.println("현재는 오후 "+this.hour+"시 "+this.min+"분 "+this.sec+"초입니다.");
		}
		else {
			
		}
	}
}

public class Ex_Watch {

	public static void main(String[] args) {
		Watch w = new Watch();
		w.hour = 12;
		w.min = 30;
		w.sec = 50;
		w.Time();
	}

}
