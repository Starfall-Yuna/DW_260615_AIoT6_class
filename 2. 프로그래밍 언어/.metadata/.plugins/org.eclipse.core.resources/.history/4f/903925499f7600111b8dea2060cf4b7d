// * 클래스 생성
class Person{	// 이름이 Person인 클래스 생성
	// * 필드(클래스 멤버변수)
	public String name;
	public String number;
	public String address;
	
	// * 메서드(클래스 멤버함수)
	public void print() {
		
	}
}

public class Java_class {

	public static void main(String[] args) {
		// * 인스턴스 생성
		Person p1 = new Person();
		p1.name = "이유나";
		p1.number = "000000-2111111";
		p1.address = "대구 북구";
		System.out.println("이름: "+p1.name);
		System.out.println("번호: "+p1.number);
		System.out.println("주소: "+p1.address);
		
		// Person을 통하여, p2 인스턴스 생성
		// 이름, 번호, 주소 임의의 값으로 삽입 + 출력
	}

}
