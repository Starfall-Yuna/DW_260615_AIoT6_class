package study;

// * Clock 클래스 작성

import java.util.Scanner;

class Clock{
	// - 필드 :: 시(hour), 분(min), 초(sec), 구입년도(year)
	//		=> 클래스에 속하는 "멤버 변수"
	public int hour;
	public int min;
	public int sec;
	public int year;
	
	// - 메소드 
	//		=> 클래스에 속하는 "멤버 함수"
	// 	- printTime() :: 시/분/초 정보 기반 시간 출력하는 메소드
	// 	- printTime(int, int, int) ::
	//		현재 시/분/초 정보 기반 시간 출력
	//		3개의 매개변수 값을 기반으로, 멤버값들을 재설정하면서 안내 메세지 출력
	public void printTime() {
		System.out.println(this.hour+"시 "+this.min+"분 "+this.sec+"초");
	}
	public void printTime(int h, int m, int s) {
		System.out.println("시간을 재설정합니다.");
		this.hour = h;
		this.min = m;
		this.sec = s;
		System.out.println(this.hour+"시 "+this.min+"분 "+this.sec+"초");
	}
	
	// 	- AmPm() :: 저장된 시간의 값이 오전인지 오후인지 출력하는 메소드
	//		(0시~11시 오전 / 12시~23시 오후)
	public void AmPm() {
		if(0<=this.hour && this.hour<12) {
			System.out.println("오전(Am)입니다.");
		}
		else {
			System.out.println("오후(Pm)입니다.");
		}
	}
	// 	- changeDevice() :: 구입년도 출력한 뒤, 2026년 기준 구입한 지 5년이 지났다면 기기 교체 안내 메시지 출력하는 메소드
	public void changeDevice() {
		System.out.println("구입년도: "+this.year);
		if(2026-this.year>=5) {
			System.out.println("기기 교체가 필요합니다.");
		}
	}
	
	// this :: "자기 자신", 멤버를 호출한 인스턴스 자신을 가리킴
}

// 파일 실행 :: public class -> main 함수 실행 (하나라도 없으면 실행X)
public class ex {
	// 함수 오버로딩 ::
	
	// 클래스 :: 객체를 생성하기 위한 양식이나 틀
	// 객체 :: "실세계에 존재하는 모든 것", 
	//		특정 클래스로 생성된 것들을 하나로 묶은 것
	// 인스턴스 :: 특정 클래스로 생성된 것들 하나하나
	public static void main(String args[]) {
		// - c1 인스턴스 생성
		Clock c1 = new Clock();
		// - c1의 필드값 설정 :: hour=0, min=0, sec=0, year=2020
		c1.hour = 0;
		c1.min = 0;
		c1.sec = 0;
		c1.year = 2020;
		// - printTime(), AmPm(), changeDevice() 실행
		c1.printTime();
		c1.AmPm();
		c1.changeDevice();
		c1.printTime(11, 30, 50)l
		System.out.println();
		
		// - c2 인스턴스 생성
		Clock c2 = new Clock();
		// - c2의 필드값 설정 :: 4개의 정수 입력받은 뒤 각각 hour/min/sec/year 멤버값 설정
		Scanner sc = new Scanner(System.in);	// Scanner 클래스에 대해 인스턴스 생성
		c2.hour = sc.nextInt();
		c2.min = sc.nextInt();
		c2.sec = sc.nextInt();
		c2.year = sc.nextInt();
		// - printTime(), AmPm(), changeDevice() 실행
		c2.printTime();
		c2.AmPm();
		c2.changeDevice();
	}
}





