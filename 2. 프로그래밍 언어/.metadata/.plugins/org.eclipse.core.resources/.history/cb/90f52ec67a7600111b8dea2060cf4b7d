
public class Ex_calc {
	// * 함수 생성
//	public static [반환형] [함수이름](매개변수타입1 매개변수명1, ...) {
//		실행할 명령문;
//	}
	// 반환형이 void? "돌려줄 값이 없다" -> return문 사용X
	public static int add(int n) {	// add 이름의 함수 (int형 정보(n) 1개 요청, int형 정보 1개 반환(n+1))
		return n+1;
	}
	
	public static void main(String args[]) {
		System.out.println(add(5));		// add 함수 실행 (5 전송)
			// "5라는 값을 add()에 빌려주고, 결과인 6을 돌려받는 상태"
	}
}
