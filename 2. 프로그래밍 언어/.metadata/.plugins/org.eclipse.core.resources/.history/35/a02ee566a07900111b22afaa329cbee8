
// 접근제어자 :: 멤버의 접근을 제어하는 구문
//		public, private (protected)

class Bus{
	// 클래스 구성 요소 :: 필드, 메소드, 생성자
	// 	- 필드(멤버변수)
	public int money;
	public String bank;
	
	//	- 메소드(멤버함수)
	public void printBuscard() {
		System.out.println("금액: "+this.money);
		System.out.println("은행명: "+this.bank);
	}
	public void available() {
		int count = money/1500;
		System.out.println("총 "+count+"번 탑승할 수 있습니다.");
	}
	
	// - 생성자 :: 인스턴스를 생성하는 특수한 메소드 
	//		=> 반환형X, 클래스명과 동일
	// 	- Bus() :: money의 값을 0으로, bank의 값을 null로 저장하는 생성자
	public Bus() {
		this.money = 0;
		this.bank = null;	// null :: "값이 없음" 명시 (0, ""(공백) 다름)
	}
	//	- Bus(int, String) :: 각 매개변수 값으로 멤버값 저장하는 생성자
	public Bus(int m, String b) {
		this.money = m;
		this.bank = b;
	}
}

public class review_Bus {
	public static void main(String args[]) {
		Bus b1 = new Bus();		// 위의 생성자 Bus() 실행
		// b1.Bus();
		b1.money = 1500;
		b1.bank = "우리은행";
		b1.printBuscard();
		b1.available();
		System.out.println();
		
		
		Bus b2 = new Bus(4500, "농협은행");	// 4500 -> m, "농협은행" -> b
			// b2.money = 4500, b2.bank = "농협은행"
		b2.printBuscard();
		b2.available();
	}
}
// 객체 :: 클래스를 통해 생성된 것
//		(동일한 클래스에서 생성된 것들 하나로 묶음)
// 인스턴스 :: 클래스를 통해 생성된 것
