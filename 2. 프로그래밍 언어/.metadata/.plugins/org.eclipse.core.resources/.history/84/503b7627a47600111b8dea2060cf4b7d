// * 클래스 생성
class Person{	// 이름이 Person인 클래스 생성
	// * 필드(클래스 멤버변수)
	public String name;
	public String number;
	public String address;
	
	// * 메서드(클래스 멤버함수)
	public void print() {
		System.out.println("이름: "+this.name);
		System.out.println("번호: "+this.number);
		System.out.println("주소: "+this.address);
	}
