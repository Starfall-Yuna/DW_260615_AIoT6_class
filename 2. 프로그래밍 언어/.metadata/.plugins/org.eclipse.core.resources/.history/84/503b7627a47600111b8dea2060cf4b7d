//	}
	
	// this :: "자기 자신의 것"
}

public class Java_class {

	public static void main(String[] args) {
		// * 인스턴스 생성
		Person p1 = new Person();
		p1.name = "이유나";
		p1.number = "000000-2111111";
		p1.address = "대구 북구";
		p1.print();
		System.out.println();
		
		Person p2 = new Person();
		p2.name = "김00";
