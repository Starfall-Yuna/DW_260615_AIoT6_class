	// * add(int, int) :: 매개변수 2개의 값을 합한 결과 return
	public static int add(int n1, int n2) {
			// add 이름의 함수 (int형 정보(n1, n2) 2개 요청, int형 정보 1개 반환(n1+n2))
		return n1+n2;
	}
	// * sub(int, int) :: 매개변수 2개의 값을 뺀 결과 return
	public static int sub(int n1, int n2) {
		return n1-n2;
	}
	// * multi(int, int) :: 매개변수 2개의 값을 곱한 결과 return
	public static int multi(int n1, int n2) {
		return n1*n2;
	}

	
